 }
 
+void send(thread_t handle, char* message) {
+	A0::write((uint64)SyscallCode::ThreadSend);
+	A1::write((uint64)handle);
+	A2::write((uint64)message);
+	ecall();
+}
+
+char* receive(thread_t handle) {
+	A0::write((uint64)SyscallCode::ThreadReceive);
+	A1::write((uint64)handle);
+	ecall();
+	return (char*)A0::read();
+}
+
+
 int time_sleep(time_t period) {
 	A0::write((uint64)SyscallCode::ThreadSleep);
 	A1::write((uint64)period);
