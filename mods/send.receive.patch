diff --git a/src/main.cpp b/src/main.cpp
index d8693ef..26b776f 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -3,13 +3,94 @@
 #include "../h/scheduler.hpp"
 #include "../h/sys.hpp"
 #include "../h/syscall_c.h"
+#include "../h/syscall_cpp.hpp"
 #include "../h/thread.hpp"
 #include "../test/userMain.hpp"
 
 static volatile bool isUserThreadFinished = false;
 
+static volatile bool doneA = false;
+static volatile bool doneB = false;
+static volatile bool doneC = false;
+
+class MsgThreadA;
+class MsgThreadB;
+class MsgThreadC;
+
+static Thread* ta = nullptr;
+static Thread* tb = nullptr;
+static Thread* tc = nullptr;
+
+class MsgThreadA : public Thread {
+  public:
+	MsgThreadA() : Thread() {}
+	void run() override {
+		for (int i = 0; i < 5; i++) {
+			tb->send((char*)"Nit A -> Nit B\n");
+			tc->send((char*)"Nit A -> Nit C\n");
+			const char* m = receive();
+			kernel::console::print(m);
+		}
+		kernel::console::print("Nit A zavrsila\n");
+		doneA = true;
+	}
+};
+
+class MsgThreadB : public Thread {
+  public:
+	MsgThreadB() : Thread() {}
+	void run() override {
+		for (int i = 0; i < 5; i++) {
+			tc->send((char*)"Nit B -> Nit C #1\n");
+			tc->send((char*)"Nit B -> Nit C #2\n");
+			// B is sent one message by A and one by C each iteration,
+			// so it must receive twice to stay balanced (else deadlock).
+			for (int j = 0; j < 2; j++) {
+				const char* m = receive();
+				kernel::console::print(m);
+			}
+		}
+		kernel::console::print("Nit B zavrsila\n");
+		doneB = true;
+	}
+};
+
+class MsgThreadC : public Thread {
+  public:
+	MsgThreadC() : Thread() {}
+	void run() override {
+		for (int i = 0; i < 5; i++) {
+			for (int j = 0; j < 3; j++) {
+				const char* m = receive();
+				kernel::console::print(m);
+			}
+			tb->send((char*)"Nit C -> Nit B\n");
+			ta->send((char*)"Nit C -> Nit A\n");
+		}
+		kernel::console::print("Nit C zavrsila\n");
+		doneC = true;
+	}
+};
+
+void messageTest() {
+	ta = new MsgThreadA();
+	tb = new MsgThreadB();
+	tc = new MsgThreadC();
+
+	ta->start();
+	tb->start();
+	tc->start();
+
+	while (!(doneA && doneB && doneC))
+		Thread::dispatch();
+
+	delete ta;
+	delete tb;
+	delete tc;
+}
+
 void user(void*) {
-	userMain();
+	messageTest();
 	isUserThreadFinished = true;
 }
 
