diff --git a/src/main.cpp b/src/main.cpp
index d8693ef..ca955de 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -3,13 +3,97 @@
 #include "../h/scheduler.hpp"
 #include "../h/sys.hpp"
 #include "../h/syscall_c.h"
+#include "../h/syscall_cpp.hpp"
 #include "../h/thread.hpp"
 #include "../test/userMain.hpp"
 
 static volatile bool isUserThreadFinished = false;
 
+// ---- Semaphore pairing test (C++ API only) ----
+//
+// 6 semaphores: one "main" with value 100, paired with 5 ordinary sems
+// whose values are 1,2,3,4,5. Thread i (id-based) waits on its own sem
+// 5 times. Once its own tokens run out, wait() falls back to the paired
+// main sem (which has plenty), and reports that it went via a paired sem.
+//
+// Expected paired-wait count per thread = max(0, 5 - initialValue):
+//   sem value 1 -> 4 paired, 2 -> 3, 3 -> 2, 4 -> 1, 5 -> 0. Total = 10.
+//
+// wait() contract assumed: returns 1 if satisfied via a paired semaphore,
+// 0 if via its own sem (or after blocking).
+
+static const int WORKERS = 5;
+
+static Semaphore* mainSem;
+static Semaphore* sems[WORKERS];
+
+static Semaphore* mutex;           // guards pairedTotal + output grouping
+static volatile int pairedTotal = 0;
+static volatile int doneCount = 0;
+
+class PairWorker : public Thread {
+	Semaphore* mine;
+	int id;
+
+  public:
+	PairWorker(Semaphore* mine, int id) : Thread(), mine(mine), id(id) {}
+
+	void run() override {
+		for (int i = 0; i < 5; i++) {
+			int viaPaired = mine->wait();
+
+			mutex->wait();
+			kernel::console::print("thread id=");
+			kernel::console::print(id);
+			kernel::console::print(" iter=");
+			kernel::console::print(i);
+			kernel::console::print(viaPaired ? " wait via PAIRED sem\n"
+											 : " wait via OWN sem\n");
+			if (viaPaired)
+				pairedTotal++;
+			mutex->signal();
+
+			Thread::sleep(2);
+		}
+
+		mutex->wait();
+		doneCount++;
+		mutex->signal();
+	}
+};
+
+void pairTest() {
+	mutex = new Semaphore(1);
+	mainSem = new Semaphore(100);
+
+	for (int i = 0; i < WORKERS; i++) {
+		sems[i] = new Semaphore(i + 1);   // values 1,2,3,4,5
+		Semaphore::pair(mainSem, sems[i]);
+	}
+
+	PairWorker* workers[WORKERS];
+	for (int i = 0; i < WORKERS; i++) {
+		workers[i] = new PairWorker(sems[i], i + 1);
+		workers[i]->start();
+	}
+
+	while (doneCount < WORKERS)
+		Thread::dispatch();
+
+	kernel::console::print("total waits via paired sems = ");
+	kernel::console::print(pairedTotal);
+	kernel::console::print(" (expected 10)\n");
+
+	for (int i = 0; i < WORKERS; i++)
+		delete workers[i];
+	for (int i = 0; i < WORKERS; i++)
+		delete sems[i];
+	delete mainSem;
+	delete mutex;
+}
+
 void user(void*) {
-	userMain();
+	pairTest();
 	isUserThreadFinished = true;
 }
 
