 	}
 
+	Semaphore::SemaphoreNode* current = paired;
+	while(current != nullptr) {
+		if (current->node->value >= (int)n) {
+			current->node->value -= (int)n;
+			return 1;
+		}
+		current = current->next;
+	}
+
 	Scheduler& sched = Scheduler::getInstance();
 	Scheduler::ThreadNode* node =
 		sched.detach(sched.readyQueue, sched.readyQueue);
@@ -93,14 +103,31 @@ Semaphore::~Semaphore() {
 		next->prev = prev;
 }
 
+void Semaphore::addPaired(Semaphore* s) {
+	MemoryAllocator& m = MemoryAllocator::getInstance();
+	Semaphore::SemaphoreNode* node =
+		(Semaphore::SemaphoreNode*)m.allocate(sizeof(Semaphore::SemaphoreNode));
+	node->node = s;
+	node->next = nullptr;
+
+	if (paired == nullptr) {
+		paired = node;
+	} else {
+		Semaphore::SemaphoreNode* current = paired;
+		while (current->next != nullptr)
+			current = current->next;
+		current->next = node;
+	}
+}
