+	A0::write((uint64)SyscallCode::ThreadSync);
+	ecall();
+}
+
+void thread_pair(thread_t t1, thread_t t2) {
+	A0::write((uint64)SyscallCode::ThreadPair);
+	A1::write((uint64)t1);
+	A2::write((uint64)t2);
+	ecall();
+}
+
 int time_sleep(time_t period) {
 	A0::write((uint64)SyscallCode::ThreadSleep);
 	A1::write((uint64)period);
