diff --git a/src/main.cpp b/src/main.cpp
index d8693ef..e61d06a 100644
--- a/src/main.cpp
+++ b/src/main.cpp
@@ -3,13 +3,67 @@
 #include "../h/scheduler.hpp"
 #include "../h/sys.hpp"
 #include "../h/syscall_c.h"
+#include "../h/syscall_cpp.hpp"
 #include "../h/thread.hpp"
 #include "../test/userMain.hpp"
 
 static volatile bool isUserThreadFinished = false;
 
+static volatile bool syncDoneA = false;
+static volatile bool syncDoneB = false;
+
+class SyncWorker : public Thread {
+	char name;
+	bool slow;
+
+  public:
+	SyncWorker(char name, bool slow) : Thread(), name(name), slow(slow) {}
+
+	void run() override {
+		for (int i = 0; i < 3; i++) {
+			if (slow)
+				Thread::sleep(1);
+
+			kernel::console::print(name);
+			kernel::console::print(" reached barrier ");
+			kernel::console::print(i);
+			kernel::console::print("\n");
+
+			sync();
+
+			kernel::console::print(name);
+			kernel::console::print(" passed barrier ");
+			kernel::console::print(i);
+			kernel::console::print("\n");
+		}
+
+		kernel::console::print(name);
+		kernel::console::print(" finished\n");
+		if (name == 'A')
+			syncDoneA = true;
+		else
+			syncDoneB = true;
+	}
+};
+
+void syncTest() {
+	SyncWorker* a = new SyncWorker('A', false);
+	SyncWorker* b = new SyncWorker('B', true);
+
+	a->start();
+	b->start();
+
+	Thread::pair(a, b);
+
+	while (!(syncDoneA && syncDoneB))
+		Thread::dispatch();
+
+	delete a;
+	delete b;
+}
+
 void user(void*) {
-	userMain();
+	syncTest();
 	isUserThreadFinished = true;
 }
 
