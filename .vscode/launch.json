{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to RISC-V QEMU",
            "type": "gdb",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "gdbpath": "gdb",
            "executable": "${workspaceFolder}/kernel/kernel",
            "target": "127.0.0.1:1234",
            "remote": true,
            "stopAtConnect": true,
            "autorun": [
                "set architecture riscv:rv64",
                "set disassemble-next-line auto",
                "set riscv use-compressed-breakpoints yes"
            ]
        }
    ]
}
